// ATB THERMO Rev7 with Wemos ESP-WROOM-02 4 MB pin map.
// Format: EV_BSP_PIN(LOGICAL_NAME, GPIO_NUM, "summary")
EV_BSP_PIN(PIN_I2C0_SCL, 5U, "ATB THERMO D1 / GPIO5 / I2C SCL")
EV_BSP_PIN(PIN_I2C0_SDA, 4U, "ATB THERMO D2 / GPIO4 / I2C SDA")
EV_BSP_PIN(PIN_PWR_CTRL, 0U, "ATB THERMO D3 / GPIO0 / JP2/Q2 peripheral power control; boot strap pin")
EV_BSP_PIN(PIN_STATUS_LED, 2U, "ATB THERMO D4 / GPIO2 / LED active-low")
EV_BSP_PIN(PIN_PIR_CHECK, 14U, "ATB THERMO D5 / GPIO14 / PIR input")
EV_BSP_PIN(PIN_AUDIO, 12U, "ATB THERMO D6 / GPIO12 / buzzer/speaker future")
EV_BSP_PIN(PIN_ONEWIRE0_DQ, 13U, "ATB THERMO D7 / GPIO13 / DS18B20 1-Wire DQ")
EV_BSP_PIN(PIN_PIR_DIS, 15U, "ATB THERMO D8 / GPIO15 / PIR disable")
EV_BSP_PIN(PIN_UART0_RX, 3U, "UART0 RX / programming/debug")
EV_BSP_PIN(PIN_UART0_TX, 1U, "UART0 TX / programming/debug")
EV_BSP_PIN_ANALOG(PIN_ADC0_INPUT, "A0 / analog input 0..4.2V through ATB THERMO divider")
